{
  "name": "wix-agents",
  "version": "1.0.0",
  "private": true,
  "description": "Local kit for connecting Cursor Cloud Agents to a Wix site via Git, CLI, MCP, and Wix Skills.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "postinstall": "node scripts/record-packages.mjs",
    "check": "bash scripts/check-setup.sh",
    "setup:local": "bash scripts/setup-local-wix.sh",
    "wix": "wix",
    "mcp:help": "npx --yes @wix/mcp-remote@latest --help"
  },
  "dependencies": {
    "@wix/agent-skills": "^1.19.0",
    "@wix/cli": "^1.1.233",
    "@wix/mcp-remote": "latest"
  }
}
