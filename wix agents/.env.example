# Copy this file to .env and fill in values from Wix.
# NEVER commit .env or paste API keys into chat/PRs.

# Required for Cloud Agents and non-interactive Wix MCP / CLI.
WIX_API_KEY=
WIX_ACCOUNT_ID=

# Optional: pin the site the agent should work on.
WIX_SITE_ID=
WIX_SITE_NAME=
WIX_SITE_URL=

# Optional: the GitHub repo Wix creates after Git Integration.
WIX_SITE_GITHUB_REPO=
